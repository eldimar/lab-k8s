aws_region      = "us-east-1"
cluster_name    = "voting-app-eks"
cluster_version = "1.36"

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
node_capacity_type  = "ON_DEMAND"

# Obrigatorio - sem default por design (ver variables.tf). Troque pelo seu
# IP publico (ex: `curl -s ifconfig.me`), nao deixe 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["SEU_IP_PUBLICO/32"]
